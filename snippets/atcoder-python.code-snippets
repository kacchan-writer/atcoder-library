      "# API: independent_sets(graph,mod=1000000007)。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "def independent_sets(graph, mod=1000000007):",
      "    n = len(graph)",
      "    if n == 0:",
      "        return 1 % mod",
      "    parent = [-1] * n",
      "    parent[0] = 0",
