  "bfs": {
    "scope": "python",
    "prefix": "acbfs",
    "description": "BFS・多始点BFS | 重み付きにはDijkstra等を使う。未到達は-1。gridは長方形で#を壁とする。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/bfs.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# BFS・多始点BFS",
      "# 条件: 重み付きにはDijkstra等を使う。未到達は-1。gridは長方形で#を壁とする。",
      "# 計算量: O(V+E)時間、O(V)補助空間。",
      "# API: bfs(graph,sources) -> 距離。grid_bfs(grid,start) -> 四近傍距離。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "from collections import deque",
      "",
      "def bfs(graph, sources):",
      "    dist = [-1] * len(graph)",
      "    queue = deque()",
      "    for s in sources:",
      "        if dist[s] == -1:",
      "            dist[s] = 0",
      "            queue.append(s)",
      "    while queue:",
      "        v = queue.popleft()",
      "        for u in graph[v]:",
      "            if dist[u] == -1:",
      "                dist[u] = dist[v] + 1",
      "                queue.append(u)",
      "    return dist",
      "",
      "def grid_bfs(grid, start):",
      "    h, w = len(grid), len(grid[0])",
      "    dist = [[-1] * w for _ in range(h)]",
      "    sy, sx = start",
      "    if grid[sy][sx] == '#':",
      "        return dist",
      "    dist[sy][sx] = 0",
      "    queue = deque([start])",
      "    while queue:",
      "        y, x = queue.popleft()",
      "        for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
      "            ny, nx = y + dy, x + dx",
      "            if 0 <= ny < h and 0 <= nx < w and grid[ny][nx] != '#' and dist[ny][nx] < 0:",
      "                dist[ny][nx] = dist[y][x] + 1",
      "                queue.append((ny, nx))",
      "    return dist",
      "",
      "$0"
    ]
  },
  "dfs": {
    "scope": "python",
    "prefix": "acdfs",
    "description": "DFS・連結成分・木の帰りがけ順 | componentsは無向グラフ用。tree_orderは空でない連結な木専用。再帰を使わない。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/dfs.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# DFS・連結成分・木の帰りがけ順",
      "# 条件: componentsは無向グラフ用。tree_orderは空でない連結な木専用。再帰を使わない。",
      "# 計算量: O(V+E)時間、O(V)補助空間。",
      "# API: components(graph) -> 成分番号。tree_order(graph,root) -> (親配列,親が先の順序)。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "def components(graph):",
      "    label = [-1] * len(graph)",
      "    number = 0",
      "    for s in range(len(graph)):",
      "        if label[s] >= 0:",
      "            continue",
      "        label[s] = number",
      "        stack = [s]",
      "        while stack:",
      "            v = stack.pop()",
      "            for u in graph[v]:",
      "                if label[u] < 0:",
      "                    label[u] = number",
      "                    stack.append(u)",
      "        number += 1",
      "    return label",
      "",
      "def tree_order(graph, root=0):",
      "    parent = [-1] * len(graph)",
      "    parent[root] = root",
      "    order = [root]",
      "    for v in order:",
      "        for u in graph[v]:",
      "            if u != parent[v]:",
      "                parent[u] = v",
      "                order.append(u)",
      "    return parent, order",
      "",
      "$0"
    ]
  },
