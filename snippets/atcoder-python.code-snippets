  "ntt": {
    "scope": "python",
    "prefix": "acntt",
    "description": "NTT・畳み込み | modは998244353固定。必要長<=2^23。整数そのままの畳み込みではなくmodを取った結果。Pythonの最大長実行は非現実的。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/ntt.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# 閲覧した参考仕様: https://atcoder.github.io/ac-library/master/document_ja/convolution.html",
      "# NTT・畳み込み",
      "# 条件: modは998244353固定。必要長<=2^23。整数そのままの畳み込みではなくmodを取った結果。Pythonの最大長実行は非現実的。",
      "# 計算量: 必要な2冪長をLとしてO(L log L)時間、O(L)空間。",
      "# API: convolution(a,b) -> 長さlen(a)+len(b)-1の係数。空列を含むと[]。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "MOD = 998244353",
      "",
      "def _ntt(a, inverse=False):",
      "    n = len(a)",
      "    j = 0",
      "    for i in range(1, n):",
      "        bit = n >> 1",
      "        while j & bit:",
      "            j ^= bit",
      "            bit >>= 1",
      "        j ^= bit",
      "        if i < j:",
      "            a[i], a[j] = a[j], a[i]",
      "    width = 2",
      "    while width <= n:",
      "        root = pow(3, (MOD - 1) // width, MOD)",
      "        if inverse:",
      "            root = pow(root, MOD - 2, MOD)",
      "        half = width // 2",
      "        for left in range(0, n, width):",
      "            w = 1",
      "            for i in range(left, left + half):",
      "                u, v = a[i], a[i+half] * w % MOD",
      "                a[i], a[i+half] = (u+v) % MOD, (u-v) % MOD",
      "                w = w * root % MOD",
      "        width *= 2",
      "    if inverse:",
      "        scale = pow(n, MOD - 2, MOD)",
      "        for i in range(n):",
      "            a[i] = a[i] * scale % MOD",
      "",
      "def convolution(a, b):",
      "    if not a or not b:",
      "        return []",
      "    length = len(a) + len(b) - 1",
      "    n = 1 << (length - 1).bit_length()",
      "    if n > 1 << 23:",
      "        raise ValueError('NTT長は2^23以下')",
      "    fa = [x % MOD for x in a] + [0] * (n-len(a))",
      "    fb = [x % MOD for x in b] + [0] * (n-len(b))",
      "    _ntt(fa)",
      "    _ntt(fb)",
      "    for i in range(n):",
      "        fa[i] = fa[i] * fb[i] % MOD",
      "    _ntt(fa, True)",
      "    return fa[:length]",
      "",
      "$0"
    ]
  },
  "min_cost_flow": {
    "scope": "python",
    "prefix": "acmcf",
    "description": "最小費用流・ポテンシャル | 元の辺の費用・容量は非負整数、s!=t。この実装は負費用の元辺に非対応。未達の場合は実際に流せた量を返す。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/min_cost_flow.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# 最小費用流・ポテンシャル",
      "# 条件: 元の辺の費用・容量は非負整数、s!=t。この実装は負費用の元辺に非対応。未達の場合は実際に流せた量を返す。",
      "# 計算量: 増加回数AとしてO(A(V+(V+E) log(E+2)))時間、O(V+E)空間。整数容量ならA<=要求流量。",
      "# API: min_cost_flow(n,edges,s,t,limit) -> (流量,総費用)。edgesは(u,v,容量,単位費用)。毎回新規計算。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "from heapq import heappush, heappop",
      "",
      "def min_cost_flow(n, edges, s, t, limit):",
      "    if s == t or limit < 0:",
      "        raise ValueError('s != t, limit >= 0 が必要')",
      "    graph = [[] for _ in range(n)]",
      "    for u, v, cap, cost in edges:",
      "        if cap < 0 or cost < 0:",
      "            raise ValueError('元辺の容量・費用は非負')",
      "        f = [v, len(graph[v]) + int(u == v), cap, cost]",
      "        r = [u, len(graph[u]), 0, -cost]",
      "        graph[u].append(f)",
      "        graph[v].append(r)",
      "    potential = [0] * n",
      "    flow = total = 0",
      "    inf = float('inf')",
      "    while flow < limit:",
      "        dist, previous = [inf] * n, [None] * n",
      "        dist[s] = 0",
      "        heap = [(0, s)]",
      "        while heap:",
      "            d, v = heappop(heap)",
      "            if d != dist[v]:",
      "                continue",
      "            for i, (u, rev, cap, cost) in enumerate(graph[v]):",
      "                nd = d + cost + potential[v] - potential[u]",
      "                if cap > 0 and nd < dist[u]:",
      "                    dist[u] = nd",
      "                    previous[u] = (v, i)",
      "                    heappush(heap, (nd, u))",
      "        if dist[t] == inf:",
      "            break",
      "        for v in range(n):",
      "            if dist[v] < inf:",
      "                potential[v] += dist[v]",
      "        amount, v = limit - flow, t",
      "        while v != s:",
      "            p, i = previous[v]",
      "            amount = min(amount, graph[p][i][2])",
      "            v = p",
      "        v = t",
      "        while v != s:",
      "            p, i = previous[v]",
      "            edge = graph[p][i]",
      "            total += amount * edge[3]",
      "            edge[2] -= amount",
      "            graph[v][edge[1]][2] += amount",
      "            v = p",
      "        flow += amount",
      "    return flow, total",
      "",
      "$0"
    ]
  },
  "hld": {
    "scope": "python",
    "prefix": "achld",
    "description": "Heavy-Light Decomposition / 重軽分解 | 空でない連結な無向木。頂点の値を足す。非可換演算や辺の値には向き・LCAの扱いを変更する。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/hld.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# Heavy-Light Decomposition / 重軽分解",
      "# 条件: 空でない連結な無向木。頂点の値を足す。非可換演算や辺の値には向き・LCAの扱いを変更する。",
      "# 計算量: この実装: 構築O(N log N)、一点加算O(log N)、経路和O(log^2 N)、空間O(N)。",
      "# API: HLDPathSum(graph,values).add(v,x)、path_sum(u,v)。両端の頂点も含む。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "class HLDPathSum:",
      "    def __init__(self, graph, values):",
      "        n = len(graph)",
      "        self.n = n",
      "        self.parent, self.depth = [-1] * n, [0] * n",
      "        self.parent[0] = 0",
      "        order = [0]",
      "        for v in order:",
      "            for u in graph[v]:",
      "                if u != self.parent[v]:",
      "                    self.parent[u] = v",
      "                    self.depth[u] = self.depth[v] + 1",
      "                    order.append(u)",
      "        size, heavy = [1] * n, [-1] * n",
      "        for v in reversed(order):",
      "            for u in graph[v]:",
      "                if u != self.parent[v]:",
      "                    size[v] += size[u]",
      "                    if heavy[v] < 0 or size[u] > size[heavy[v]]:",
      "                        heavy[v] = u",
      "        self.head, self.pos = [0] * n, [0] * n",
      "        stack, timer = [(0, 0)], 0",
      "        while stack:",
      "            v, h = stack.pop()",
      "            while v >= 0:",
      "                self.head[v], self.pos[v] = h, timer",
      "                timer += 1",
      "                for u in graph[v]:",
      "                    if u != self.parent[v] and u != heavy[v]:",
      "                        stack.append((u, u))",
      "                v = heavy[v]",
      "        self.bit = [0] * (n + 1)",
      "        for v, x in enumerate(values):",
      "            self.add(v, x)",
      "",
      "    def add(self, v, x):",
      "        i = self.pos[v] + 1",
      "        while i <= self.n:",
      "            self.bit[i] += x",
      "            i += i & -i",
      "",
      "    def _prefix(self, r):",
      "        total = 0",
      "        while r:",
      "            total += self.bit[r]",
      "            r -= r & -r",
      "        return total",
      "",
      "    def path_sum(self, u, v):",
      "        total = 0",
      "        while self.head[u] != self.head[v]:",
      "            if self.depth[self.head[u]] < self.depth[self.head[v]]:",
      "                u, v = v, u",
      "            h = self.head[u]",
      "            total += self._prefix(self.pos[u] + 1) - self._prefix(self.pos[h])",
      "            u = self.parent[h]",
      "        l, r = sorted((self.pos[u], self.pos[v]))",
      "        return total + self._prefix(r + 1) - self._prefix(l)",
      "",
      "$0"
    ]
  },
  "li_chao_tree": {
    "scope": "python",
    "prefix": "aclichao",
    "description": "Li Chao Tree・直線の最小値 | 問合せ座標を事前に全て渡す離散版。任意の曲線には使えない。直線がなければinf。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/li_chao_tree.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# Li Chao Tree・直線の最小値",
      "# 条件: 問合せ座標を事前に全て渡す離散版。任意の曲線には使えない。直線がなければinf。",
      "# 計算量: 座標M個: 準備O(M log M)、直線追加・問合せO(log(M+1))、空間O(M)。",
      "# API: LiChao(xs).add_line(a,b)、query(x)。xは初期xs内の値。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "from bisect import bisect_left",
      "",
      "class LiChao:",
      "    def __init__(self, xs):",
      "        self.xs = sorted(set(xs))",
      "        if not self.xs:",
      "            raise ValueError('座標が1個以上必要')",
      "        self.lines = [None] * (4 * len(self.xs))",
      "",
      "    def add_line(self, a, b):",
      "        def put(k, l, r, line):",
      "            if self.lines[k] is None:",
      "                self.lines[k] = line",
      "                return",
      "            m = (l + r) // 2",
      "            current = self.lines[k]",
      "            left_better = line[0] * self.xs[l] + line[1] < current[0] * self.xs[l] + current[1]",
      "            mid_better = line[0] * self.xs[m] + line[1] < current[0] * self.xs[m] + current[1]",
      "            if mid_better:",
      "                self.lines[k], line = line, current",
      "            if r-l == 1:",
      "                return",
      "            if left_better != mid_better:",
      "                put(2*k, l, m, line)",
      "            else:",
      "                put(2*k+1, m, r, line)",
      "        put(1, 0, len(self.xs), (a, b))",
      "",
      "    def query(self, x):",
      "        i = bisect_left(self.xs, x)",
      "        if i == len(self.xs) or self.xs[i] != x:",
      "            raise ValueError('初期座標にないx')",
      "        k, l, r, result = 1, 0, len(self.xs), float('inf')",
      "        while True:",
      "            line = self.lines[k]",
      "            if line is not None:",
      "                result = min(result, line[0] * x + line[1])",
      "            if r-l == 1:",
      "                return result",
      "            m = (l+r)//2",
      "            if i < m:",
      "                k, r = 2*k, m",
      "            else:",
      "                k, l = 2*k+1, m",
      "",
      "$0"
    ]
  },
