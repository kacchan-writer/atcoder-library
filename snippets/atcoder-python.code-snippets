      "                if not (mask >> u & 1):",
      "                    nxt = mask | (1 << u)",
      "                    dp[nxt][u] = min(dp[nxt][u], dp[mask][v] + cost[v][u])",
      "    return min(dp[-1][v] + cost[v][0] for v in range(1, n))",
