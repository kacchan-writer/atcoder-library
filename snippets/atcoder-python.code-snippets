      "        graph[a ^ 1].append(b)",
      "        graph[b ^ 1].append(a)",
      "    ids, _ = scc(graph)",
      "    if any(ids[2*i] == ids[2*i+1] for i in range(n)):",
      "        return None",
      "    return [ids[2*i] < ids[2*i+1] for i in range(n)]",
