      "        seen[s] = True",
      "        stack = [s]",
      "        while stack:",
      "            v = stack.pop()",
      "            for u, rev, cap in self.graph[v]:",
      "                if cap > 0 and not seen[u]:",
      "                    seen[u] = True",
      "                    stack.append(u)",
      "        return seen",
      "",
      "$0"
    ]
