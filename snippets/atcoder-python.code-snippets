      "    reverse = [[] for _ in range(n)]",
      "    for v, row in enumerate(graph):",
      "        for u in row:",
      "            reverse[u].append(v)",
      "    seen, order = [False] * n, []",
      "    for start in range(n):",
      "        if seen[start]:",
      "            continue",
      "        seen[start] = True",
      "        stack = [(start, 0)]",
      "        while stack:",
      "            v, i = stack[-1]",
      "            if i == len(graph[v]):",
      "                order.append(v)",
      "                stack.pop()",
      "            else:",
      "                stack[-1] = (v, i + 1)",
      "                u = graph[v][i]",
      "                if not seen[u]:",
      "                    seen[u] = True",
      "                    stack.append((u, 0))",
      "    ids, groups = [-1] * n, []",
      "    for start in reversed(order):",
      "        if ids[start] >= 0:",
      "            continue",
      "        group = []",
      "        ids[start] = len(groups)",
      "        stack = [start]",
      "        while stack:",
      "            v = stack.pop()",
      "            group.append(v)",
      "            for u in reverse[v]:",
      "                if ids[u] < 0:",
      "                    ids[u] = ids[start]",
      "                    stack.append(u)",
      "        groups.append(group)",
      "    return ids, groups",
      "",
      "",
      "def two_sat(n, clauses):",
      "    graph = [[] for _ in range(2 * n)]",
      "    for i, f, j, g in clauses:",
