    "scope": "python",
    "prefix": "acrollback",
    "description": "Rollback Union-Find | 経路圧縮をしない。snapshotは現在の履歴の祖先だけに戻せる。任意の辺削除を直接処理する構造ではない。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/rollback_dsu.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# Rollback Union-Find",
      "# 条件: 経路圧縮をしない。snapshotは現在の履歴の祖先だけに戻せる。任意の辺削除を直接処理する構造ではない。",
      "# 計算量: leader/merge O(log N)、snapshot O(1)、rollbackは取り消す併合数O(K)、空間O(N+履歴)。",
      "# API: RollbackDSU(n).merge(a,b)、same(a,b)、snapshot()、rollback(token)。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "class RollbackDSU:",
      "    def __init__(self, n):",
      "        self.parent, self.history = [-1] * n, []",
      "",
      "    def leader(self, v):",
      "        while self.parent[v] >= 0:",
      "            v = self.parent[v]",
      "        return v",
      "",
      "    def same(self, a, b):",
      "        return self.leader(a) == self.leader(b)",
      "",
      "    def merge(self, a, b):",
      "        a, b = self.leader(a), self.leader(b)",
      "        if a == b:",
      "            return False",
      "        if self.parent[a] > self.parent[b]:",
      "            a, b = b, a",
      "        self.history.append((a, self.parent[a], b, self.parent[b]))",
      "        self.parent[a] += self.parent[b]",
      "        self.parent[b] = a",
      "        return True",
      "",
      "    def snapshot(self):",
      "        return len(self.history)",
      "",
      "    def rollback(self, token):",
      "        if not 0 <= token <= len(self.history):",
      "            raise ValueError('現在の履歴内のsnapshotが必要')",
      "        while len(self.history) > token:",
      "            a, pa, b, pb = self.history.pop()",
      "            self.parent[a], self.parent[b] = pa, pb",
      "",
      "$0"
    ]
  },
  "sos_dp": {
    "scope": "python",
    "prefix": "acsos",
    "description": "部分集合ゼータ変換・Möbius反転 / SOS DP | 長さは正の2冪。ここでは整数の和。単なる部分集合の総和と部分集合畳み込みは別。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/sos_dp.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# 部分集合ゼータ変換・Möbius反転 / SOS DP",
      "# 条件: 長さは正の2冪。ここでは整数の和。単なる部分集合の総和と部分集合畳み込みは別。",
      "# 計算量: Bビット、配列長N=2^BとしてO(B 2^B)時間、O(2^B)空間。",
      "# API: subset_zeta(a)、subset_mobius(a)。元配列を変更せず新しいリストを返す。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "def _transform(a, sign):",
      "    n = len(a)",
      "    if not n or n & (n - 1):",
      "        raise ValueError('長さは正の2冪')",
      "    result = list(a)",
      "    bit = 1",
      "    while bit < n:",
      "        for mask in range(n):",
      "            if mask & bit:",
      "                result[mask] += sign * result[mask ^ bit]",
      "        bit <<= 1",
      "    return result",
      "",
      "def subset_zeta(a):",
      "    return _transform(a, 1)",
      "",
      "def subset_mobius(a):",
      "    return _transform(a, -1)",
      "",
      "$0"
    ]
  },
  "suffix_array": {
    "scope": "python",
    "prefix": "acsa",
    "description": "Suffix Array・LCP | SA-ISの線形実装ではない。空文字対応。Unicode文字もPythonの比較順で扱う。大規模には高速実装が必要。",
    "body": [
      "# Source: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/library/suffix_array.py",
      "# Provenance: https://github.com/kacchan-writer/atcoder-library/blob/72b5963edde2f2daad36c0ca5aaa6c54ae257d09/PROVENANCE.md",
      "# AI生成: OpenAI Codex（2026-10-12）。出典の確認範囲は PROVENANCE.md を参照。",
      "# Suffix Array・LCP",
      "# 条件: SA-ISの線形実装ではない。空文字対応。Unicode文字もPythonの比較順で扱う。大規模には高速実装が必要。",
      "# 計算量: このdoubling実装はO(N log^2(N+1))時間・O(N)空間。LCPはO(N)。",
      "# API: suffix_array(s)、lcp_array(s,sa)。lcp[i]はsa[i]とsa[i+1]の一致長。",
      "# 添字は原則0始まり、区間は [l, r)。末尾は単独実行用の例。",
      "def suffix_array(s):",
      "    n = len(s)",
      "    values = {c: i for i, c in enumerate(sorted(set(s)))\\}",
      "    rank, sa = [values[c] for c in s], list(range(n))",
      "    width = 1",
      "    while width < n:",
      "        def key(i):",
      "            return rank[i], rank[i+width] if i+width < n else -1",
      "        sa.sort(key=key)",
      "        nxt = [0] * n",
      "        for j in range(1, n):",
      "            nxt[sa[j]] = nxt[sa[j-1]] + (key(sa[j-1]) != key(sa[j]))",
      "        rank = nxt",
      "        if rank[sa[-1]] == n-1:",
      "            break",
      "        width *= 2",
      "    return sa",
      "",
      "def lcp_array(s, sa):",
      "    n = len(s)",
      "    if n <= 1:",
      "        return []",
      "    rank = [0] * n",
      "    for r, i in enumerate(sa):",
      "        rank[i] = r",
      "    lcp, h = [0] * (n-1), 0",
      "    for i in range(n):",
      "        r = rank[i]",
      "        if r == 0:",
      "            h = 0",
      "            continue",
      "        j = sa[r-1]",
      "        while i+h < n and j+h < n and s[i+h] == s[j+h]:",
      "            h += 1",
      "        lcp[r-1] = h",
      "        h = max(0, h-1)",
      "    return lcp",
      "",
      "$0"
    ]
  },
